{
  "name": "@zbochuan/dsh-paper-reader",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin for reading papers: select a line in a PDF and ask DeepSeek, in a VS Code-style dockable layout.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "reader",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "pdf",
    "paper-reading"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
